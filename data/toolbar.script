<div id="pcw" dir="rtl" style="background:linear-gradient(135deg,#0a192f,#1b3a5c);color:#fff;font-family:'Vazirmatn','IRANSans','Tahoma',sans-serif;border-radius:clamp(12px,3vw,24px);padding:clamp(12px,3vw,25px);box-shadow:0 20px 40px rgba(0,0,0,.5);text-align:center;max-width:100%;width:100%;margin:0 auto;border:2px solid rgba(0,180,255,.3);direction:rtl;box-sizing:border-box;overflow:hidden"><div id="pcw-st" style="font-size:clamp(8px,1.5vw,11px);margin-bottom:clamp(8px,2vw,15px);opacity:.85;letter-spacing:.5px;background:rgba(0,0,0,.35);padding:clamp(4px,1vw,6px) clamp(12px,2vw,18px);border-radius:30px;display:inline-block;font-weight:500;direction:rtl;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100%;box-sizing:border-box">⌛ در حال همگام‌سازی...</div><div id="pcw-tm" style="font-size:clamp(28px,8vw,56px);font-weight:900;letter-spacing:clamp(2px,.5vw,5px);line-height:1.2;direction:ltr;text-shadow:0 5px 20px rgba(0,0,0,.7);font-family:'Courier New','Vazirmatn',monospace;margin:clamp(5px,1vw,10px) 0;white-space:nowrap;box-sizing:border-box">--:--:--</div><div id="pcw-dt" style="font-size:clamp(12px,3vw,20px);font-weight:600;margin-top:clamp(5px,1vw,10px);opacity:.95;background:rgba(255,255,255,.08);padding:clamp(6px,1.5vw,10px) clamp(12px,2vw,20px);border-radius:clamp(8px,2vw,12px);display:inline-block;backdrop-filter:blur(5px);direction:rtl;white-space:nowrap;box-sizing:border-box;max-width:100%;overflow:hidden;text-overflow:ellipsis">---</div></div><script>(function(){'use strict';const DM=100,TM=1e3,RM=3e5,FM=3e4,AM=5e3,IM=126e5;let r=!1,t=null,e=0,i=null,n=null,s=null;function adj(){let w=document.getElementById('pcw'),a=document.getElementById('pcw-tm'),d=document.getElementById('pcw-dt'),st=document.getElementById('pcw-st');if(!w||!a||!d||!st)return;let W=w.offsetWidth,tf,df,sf,pf,rf;if(W<200){tf=Math.max(20,W*.18);df=Math.max(9,W*.07);sf=Math.max(6,W*.05);pf=Math.max(8,W*.06);rf=Math.max(8,W*.08)}else if(W<300){tf=Math.max(24,W*.15);df=Math.max(10,W*.06);sf=Math.max(7,W*.045);pf=Math.max(10,W*.05);rf=Math.max(10,W*.06)}else if(W<400){tf=Math.max(28,W*.13);df=Math.max(11,W*.05);sf=Math.max(8,W*.04);pf=Math.max(12,W*.04);rf=Math.max(12,W*.05)}else{tf=56;df=20;sf=11;pf=25;rf=24}a.style.fontSize=tf+'px';a.style.letterSpacing=(tf*.09)+'px';d.style.fontSize=df+'px';d.style.padding=(df*.5)+'px '+(df*1)+'px';st.style.fontSize=sf+'px';st.style.padding=(sf*.5)+'px '+(sf*1.5)+'px';w.style.padding=pf+'px';w.style.borderRadius=rf+'px'}adj();if(typeof ResizeObserver!=='undefined'){new ResizeObserver(adj).observe(document.getElementById('pcw'))}else{window.addEventListener('resize',adj);setInterval(adj,2e3)}async function ft(){try{let c=new AbortController(),id=setTimeout(()=>c.abort(),AM),res=await fetch('https://timeapi.io/api/Time/current/zone?timeZone=UTC',{signal:c.signal,cache:'no-store',mode:'cors'});clearTimeout(id);if(!res.ok)return null;let d=await res.json(),u=Date.UTC(d.year,d.month-1,d.day,d.hour,d.minute,d.seconds,d.milliSeconds||0);return isNaN(u)?null:u}catch(e){return null}}function sc(u){if(i){clearInterval(i);i=null}t=u;e=0;r=!0;i=setInterval(()=>{e++},TM)}function gc(){return(!r||t===null)?null:t+e*1e3}function pn(n,l=2){return String(n).padStart(l,'0')}function gi(u){let x=new Date(u+IM);return{h:x.getUTCHours(),m:x.getUTCMinutes(),s:x.getUTCSeconds(),d:x.getUTCDate(),mo:x.getUTCMonth()+1,y:x.getUTCFullYear(),dw:x.getUTCDay()}}function fmt(ir){return pn(ir.h)+':'+pn(ir.m)+':'+pn(ir.s)}function pd(n){return String(n).replace(/\d/g,d=>'۰۱۲۳۴۵۶۷۸۹'[parseInt(d)])}function fpd(u){let x=new Date(u+IM);try{let p=new Intl.DateTimeFormat('fa-IR',{weekday:'long',day:'numeric',month:'long',year:'numeric',timeZone:'Asia/Tehran'}).formatToParts(x),wd='',dy='',mo='',yr='';for(let q of p){if(q.type==='weekday')wd=q.value;if(q.type==='day')dy=q.value;if(q.type==='month')mo=q.value;if(q.type==='year')yr=q.value}return wd+'، '+dy+' '+mo+' '+yr}catch(e){return fpdm(x)}}function fpdm(x){let gy=x.getUTCFullYear(),gm=x.getUTCMonth()+1,gd=x.getUTCDate(),gdm=[31,28,31,30,31,30,31,31,30,31,30,31],gdn=0;for(let i=0;i<gm-1;i++)gdn+=gdm[i];gdn+=gd;let lg=(gy%4===0&&gy%100!==0)||(gy%400===0);if(lg&&gm>2)gdn++;let jy=gy-621,jdn=gdn-79,jdm=[31,31,31,31,31,31,30,30,30,30,30,29],jm=0,jd=jdn;if(jdn>186){jd-=186;jm=6}while(jd>jdm[jm]){jd-=jdm[jm];jm++;if(jm>11)break}jm++;let dn=['یکشنبه','دوشنبه','سه‌شنبه','چهارشنبه','پنجشنبه','جمعه','شنبه'],mn=['فروردین','اردیبهشت','خرداد','تیر','مرداد','شهریور','مهر','آبان','آذر','دی','بهمن','اسفند'];return dn[x.getUTCDay()]+'، '+pd(jd)+' '+mn[jm-1]+' '+pd(jy)}function ud(){let c=gc();if(c===null)return;let a=document.getElementById('pcw-tm'),d=document.getElementById('pcw-dt'),ir=gi(c);if(a)a.textContent=fmt(ir);if(d)d.textContent=fpd(c)}async function st(){let el=document.getElementById('pcw-st');if(!el)return;let u=await ft();if(u){sc(u);el.textContent='✅ همگام با TimeAPI.io';if(s){clearInterval(s);s=null}s=setInterval(st,RM)}else{if(r){el.textContent='⚠️ قطع ارتباط - ادامه با ساعت داخلی'}else{el.textContent='⚠️ خطا در دریافت زمان - تلاش مجدد...'}if(s){clearInterval(s)}s=setInterval(st,FM)}}async function init(){adj();await st();if(n){clearInterval(n)}n=setInterval(ud,DM);if(!r){setTimeout(st,5e3)}}if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',init)}else{init()}})();</script>


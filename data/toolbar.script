<div id="pcw" dir="rtl" style="background:linear-gradient(135deg,#0a192f,#1b3a5c);color:#fff;font-family:'Vazirmatn','IRANSans','Tahoma',sans-serif;border-radius:16px;padding:15px;box-shadow:0 10px 25px rgba(0,0,0,.4);text-align:center;max-width:100%;width:100%;margin:0 auto;border:2px solid rgba(0,180,255,.3);direction:rtl;box-sizing:border-box;overflow:hidden"><div id="pcw-st" style="font-size:10px;margin-bottom:10px;opacity:.85;background:rgba(0,0,0,.35);padding:4px 14px;border-radius:20px;display:inline-block;font-weight:500;direction:rtl;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100%;box-sizing:border-box">⌛ در حال همگام‌سازی...</div><div id="pcw-tm" style="font-size:48px;font-weight:900;letter-spacing:4px;line-height:1.2;direction:ltr;text-shadow:0 3px 12px rgba(0,0,0,.6);font-family:'Courier New','Vazirmatn',monospace;margin:8px 0;white-space:nowrap;box-sizing:border-box">--:--:--</div><div id="pcw-dt" style="font-size:18px;font-weight:600;margin-top:8px;opacity:.95;background:rgba(255,255,255,.08);padding:8px 16px;border-radius:10px;display:inline-block;direction:rtl;white-space:nowrap;box-sizing:border-box;max-width:100%;overflow:hidden;text-overflow:ellipsis">---</div></div><script>(function(){'use strict';var DM=100,TM=1e3,RM=3e5,FM=3e4,IM=126e5;var r=!1,t=null,e=0,i=null,n=null,s=null;function adj(){var w=document.getElementById('pcw'),a=document.getElementById('pcw-tm'),d=document.getElementById('pcw-dt'),st=document.getElementById('pcw-st');if(!w||!a||!d||!st)return;var W=w.offsetWidth||w.clientWidth||300;var tf,df,sf,pf;if(W<200){tf=Math.max(18,W*.16);df=Math.max(8,W*.065);sf=Math.max(6,W*.05);pf=Math.max(6,W*.05)}else if(W<300){tf=Math.max(22,W*.14);df=Math.max(9,W*.055);sf=Math.max(7,W*.045);pf=Math.max(8,W*.045)}else if(W<400){tf=Math.max(26,W*.12);df=Math.max(10,W*.05);sf=Math.max(8,W*.04);pf=Math.max(10,W*.04)}else{tf=48;df=18;sf=10;pf=15}a.style.fontSize=tf+'px';a.style.letterSpacing=(tf*.08)+'px';d.style.fontSize=df+'px';d.style.padding=(df*.4)+'px '+(df*.8)+'px';st.style.fontSize=sf+'px';st.style.padding=(sf*.4)+'px '+(sf*1.2)+'px';w.style.padding=pf+'px'}adj();setInterval(adj,2e3);function ft(cb){var cbName='pcw_cb_'+Date.now();var script=document.createElement('script');var timeout=setTimeout(function(){try{delete window[cbName];document.body.removeChild(script)}catch(e){}cb(null)},5e3);window[cbName]=function(data){try{clearTimeout(timeout);delete window[cbName];document.body.removeChild(script);var u=Date.UTC(data.year,data.month-1,data.day,data.hour,data.minute,data.seconds,data.milliSeconds||0);cb(isNaN(u)?null:u)}catch(e){cb(null)}};script.onerror=function(){try{clearTimeout(timeout);delete window[cbName];document.body.removeChild(script)}catch(e){}cb(null)};script.src='https://timeapi.io/api/Time/current/zone?timeZone=UTC&callback='+cbName;document.body.appendChild(script)}function sc(u){if(i){clearInterval(i);i=null}t=u;e=0;r=!0;i=setInterval(function(){e++},TM)}function gc(){return(!r||t===null)?null:t+e*1e3}function pn(n,l){l=l||2;return String(n).padStart(l,'0')}function gi(u){var x=new Date(u+IM);return{h:x.getUTCHours(),m:x.getUTCMinutes(),s:x.getUTCSeconds(),d:x.getUTCDate(),mo:x.getUTCMonth()+1,y:x.getUTCFullYear(),dw:x.getUTCDay()}}function fmt(ir){return pn(ir.h)+':'+pn(ir.m)+':'+pn(ir.s)}function pd(n){return String(n).replace(/\d/g,function(d){return'۰۱۲۳۴۵۶۷۸۹'[parseInt(d)]})}function fpd(u){var x=new Date(u+IM);try{var p=new Intl.DateTimeFormat('fa-IR',{weekday:'long',day:'numeric',month:'long',year:'numeric',timeZone:'Asia/Tehran'}).formatToParts(x),wd='',dy='',mo='',yr='';for(var q=0;q<p.length;q++){if(p[q].type==='weekday')wd=p[q].value;if(p[q].type==='day')dy=p[q].value;if(p[q].type==='month')mo=p[q].value;if(p[q].type==='year')yr=p[q].value}return wd+'، '+dy+' '+mo+' '+yr}catch(err){return fpdm(x)}}function fpdm(x){var gy=x.getUTCFullYear(),gm=x.getUTCMonth()+1,gd=x.getUTCDate(),gdm=[31,28,31,30,31,30,31,31,30,31,30,31],gdn=0;for(var i=0;i<gm-1;i++)gdn+=gdm[i];gdn+=gd;var lg=(gy%4===0&&gy%100!==0)||(gy%400===0);if(lg&&gm>2)gdn++;var jy=gy-621,jdn=gdn-79,jdm=[31,31,31,31,31,31,30,30,30,30,30,29],jm=0,jd=jdn;if(jdn>186){jd-=186;jm=6}while(jd>jdm[jm]){jd-=jdm[jm];jm++;if(jm>11)break}jm++;var dn=['یکشنبه','دوشنبه','سه‌شنبه','چهارشنبه','پنجشنبه','جمعه','شنبه'],mn=['فروردین','اردیبهشت','خرداد','تیر','مرداد','شهریور','مهر','آبان','آذر','دی','بهمن','اسفند'];return dn[x.getUTCDay()]+'، '+pd(jd)+' '+mn[jm-1]+' '+pd(jy)}function ud(){var c=gc();if(c===null)return;var a=document.getElementById('pcw-tm'),d=document.getElementById('pcw-dt'),ir=gi(c);if(a)a.textContent=fmt(ir);if(d)d.textContent=fpd(c)}function st(){var el=document.getElementById('pcw-st');if(!el)return;ft(function(u){if(u){sc(u);el.textContent='✅ همگام با TimeAPI.io';if(s){clearInterval(s)}s=setInterval(st,RM)}else{if(r){el.textContent='⚠️ قطع ارتباط - ادامه با ساعت داخلی'}else{el.textContent='⚠️ خطا در دریافت زمان - تلاش مجدد...'}if(s){clearInterval(s)}s=setInterval(st,FM)}})}function init(){adj();st();if(n){clearInterval(n)}n=setInterval(ud,DM);if(!r){setTimeout(st,5e3)}}if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',init)}else{init()}})();</script>


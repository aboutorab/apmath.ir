<div id="pcw" dir="rtl" style="background:linear-gradient(135deg,#0a192f,#1b3a5c);color:#fff;font-family:Vazirmatn,IRANSans,Tahoma,sans-serif;border-radius:24px;padding:25px;box-shadow:0 20px 40px rgba(0,0,0,.5);text-align:center;max-width:100%;width:100%;margin:0 auto;border:2px solid rgba(0,180,255,.3);direction:rtl;box-sizing:border-box;overflow:hidden"><div id="pcw-s" style="font-size:11px;margin-bottom:15px;opacity:.85;background:rgba(0,0,0,.35);padding:6px 18px;border-radius:30px;display:inline-block;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100%;box-sizing:border-box">⌛ در حال همگام‌سازی...</div><div id="pcw-t" style="font-size:56px;font-weight:900;letter-spacing:5px;line-height:1.2;direction:ltr;text-shadow:0 5px 20px rgba(0,0,0,.7);font-family:'Courier New',Vazirmatn,monospace;margin:10px 0;white-space:nowrap">--:--:--</div><div id="pcw-d" style="font-size:20px;font-weight:600;margin-top:10px;opacity:.95;background:rgba(255,255,255,.08);padding:10px 20px;border-radius:12px;display:inline-block;direction:rtl;white-space:nowrap;box-sizing:border-box;max-width:100%;overflow:hidden;text-overflow:ellipsis">---</div></div>
<script>
(function(){'use strict';
const R=5*60*1000,O=(3*60*60*1000)+(30*60*1000);
let T=null,c=0,ti=null,di=null,si=null,run=false;
function pad(n,l=2){return String(n).padStart(l,'0')}
function fa(s){return String(s).replace(/\d/g,d=>'۰۱۲۳۴۵۶۷۸۹'[d])}
async function api(){try{const c=new AbortController(),t=setTimeout(()=>c.abort(),5000),r=await fetch('https://timeapi.io/api/Time/current/zone?timeZone=UTC',{signal:c.signal,cache:'no-store'});clearTimeout(t);if(!r.ok)return null;const d=await r.json();const u=Date.UTC(d.year,d.month-1,d.day,d.hour,d.minute,d.seconds,d.milliSeconds||0);return isNaN(u)?null:u}catch(e){return null}}
function start(u){if(ti)clearInterval(ti);T=u;c=0;run=true;ti=setInterval(()=>c++,1000)}
function now(){return run&&T!==null?T+c*1000:null}
function iran(u){const d=new Date(u+O);return{h:d.getUTCHours(),m:d.getUTCMinutes(),s:d.getUTCSeconds()}}
function pdate(u){const d=new Date(u+O);try{const p=new Intl.DateTimeFormat('fa-IR',{weekday:'long',day:'numeric',month:'long',year:'numeric',timeZone:'Asia/Tehran'}).formatToParts(d);let w='',dd='',m='',y='';for(const x of p){if(x.type==='weekday')w=x.value;if(x.type==='day')dd=x.value;if(x.type==='month')m=x.value;if(x.type==='year')y=x.value}return`${w}، ${dd} ${m} ${y}`}catch(e){const dn=['یکشنبه','دوشنبه','سه‌شنبه','چهارشنبه','پنجشنبه','جمعه','شنبه'],mn=['فروردین','اردیبهشت','خرداد','تیر','مرداد','شهریور','مهر','آبان','آذر','دی','بهمن','اسفند'];let g=d.getUTCDate(),mo=d.getUTCMonth()+1,ye=d.getUTCFullYear();let dn0=0;for(let i=0;i<mo-1;i++)dn0+=[31,28,31,30,31,30,31,31,30,31,30,31][i];dn0+=g;if((ye%4===0&&ye%100!==0)||ye%400===0)if(mo>2)dn0++;let jy=ye-621,jd=dn0-79;if(jd<=0)jd+=365;let jm=0,jday=jd;if(jd>186){jd-=186;jm=6}const jdm=[31,31,31,31,31,31,30,30,30,30,30,29];while(jday>jdm[jm]){jday-=jdm[jm];jm++;if(jm>11)break}jm++;return`${dn[d.getUTCDay()]}، ${fa(jday)} ${mn[jm-1]} ${fa(jy)}`}}
function disp(){const u=now();if(u===null)return;const t=document.getElementById('pcw-t'),dd=document.getElementById('pcw-d'),i=iran(u);if(t)t.textContent=`${pad(i.h)}:${pad(i.m)}:${pad(i.s)}`;if(dd)dd.textContent=pdate(u)}
function resp(){const w=document.getElementById('pcw'),t=document.getElementById('pcw-t'),d=document.getElementById('pcw-d'),s=document.getElementById('pcw-s');if(!w||!t||!d||!s)return;function adj(){const ww=w.offsetWidth;let tf,df,sf,p,b;if(ww<200){tf=Math.max(20,ww*.18);df=Math.max(9,ww*.07);sf=Math.max(6,ww*.05);p=Math.max(8,ww*.06);b=Math.max(8,ww*.08)}else if(ww<300){tf=Math.max(24,ww*.15);df=Math.max(10,ww*.06);sf=Math.max(7,ww*.045);p=Math.max(10,ww*.05);b=Math.max(10,ww*.06)}else if(ww<400){tf=Math.max(28,ww*.13);df=Math.max(11,ww*.05);sf=Math.max(8,ww*.04);p=Math.max(12,ww*.04);b=Math.max(12,ww*.05)}else{tf=56;df=20;sf=11;p=25;b=24}t.style.fontSize=tf+'px';t.style.letterSpacing=(tf*.09)+'px';d.style.fontSize=df+'px';d.style.padding=(df*.5)+'px '+(df*1)+'px';s.style.fontSize=sf+'px';s.style.padding=(sf*.5)+'px '+(sf*1.5)+'px';w.style.padding=p+'px';w.style.borderRadius=b+'px'}adj();if(typeof ResizeObserver!=='undefined'){new ResizeObserver(adj).observe(w)}else{window.addEventListener('resize',adj);setInterval(adj,2000)}}
async function sync(){const s=document.getElementById('pcw-s');if(!s)return;const u=await api();if(u){start(u);s.textContent='✅ همگام با TimeAPI.io';if(si)clearInterval(si);si=setInterval(sync,R)}else{s.textContent=run?'⚠️ قطع ارتباط - ادامه با ساعت داخلی':'⚠️ خطا در دریافت زمان - تلاش مجدد...';if(si)clearInterval(si);si=setInterval(sync,30000)}}
async function init(){resp();await sync();if(di)clearInterval(di);di=setInterval(disp,100);if(!run)setTimeout(sync,5000)}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init);else init()})();
</script>


<script>
(function(){var h='<!DOCTYPE html><html dir="rtl" lang="fa"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><style>*{margin:0;padding:0;box-sizing:border-box}body{background:0 0;font-family:Vazirmatn,IRANSans,Tahoma,sans-serif;display:flex;align-items:center;justify-content:center;min-height:100vh;overflow:hidden}#pcw{background:linear-gradient(135deg,#0a192f,#1b3a5c);color:#fff;border-radius:24px;padding:25px;text-align:center;width:100%;max-width:100%;border:2px solid rgba(0,180,255,.3);direction:rtl;box-sizing:border-box;overflow:hidden}#pcw-s{font-size:11px;margin-bottom:15px;opacity:.85;background:rgba(0,0,0,.35);padding:6px 18px;border-radius:30px;display:inline-block;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100%}#pcw-t{font-size:56px;font-weight:900;letter-spacing:5px;line-height:1.2;direction:ltr;text-shadow:0 5px 20px rgba(0,0,0,.7);font-family:"Courier New",Vazirmatn,monospace;margin:10px 0;white-space:nowrap}#pcw-d{font-size:20px;font-weight:600;margin-top:10px;opacity:.95;background:rgba(255,255,255,.08);padding:10px 20px;border-radius:12px;display:inline-block;direction:rtl;white-space:nowrap;max-width:100%;overflow:hidden;text-overflow:ellipsis}</style></head><body><div id="pcw"><div id="pcw-s">⌛ در حال همگام‌سازی...</div><div id="pcw-t">--:--:--</div><div id="pcw-d">---</div></div><script>(function(){"use strict";var R=3e5,O=126e5,T=null,c=0,ti=null,di=null,si=null,run=false;function pad(n,l){l=l||2;return String(n).padStart(l,"0")}function fa(s){return String(s).replace(/\d/g,function(d){return"۰۱۲۳۴۵۶۷۸۹"[d]})}async function api(){try{var c=new AbortController(),t=setTimeout(function(){c.abort()},5e3),r=await fetch("https://timeapi.io/api/Time/current/zone?timeZone=UTC",{signal:c.signal,cache:"no-store"});clearTimeout(t);if(!r.ok)return null;var d=await r.json(),u=Date.UTC(d.year,d.month-1,d.day,d.hour,d.minute,d.seconds,d.milliSeconds||0);return isNaN(u)?null:u}catch(e){return null}}function start(u){if(ti)clearInterval(ti);T=u;c=0;run=true;ti=setInterval(function(){c++},1e3)}function now(){return run&&T!==null?T+c*1e3:null}function iran(u){var d=new Date(u+O);return{h:d.getUTCHours(),m:d.getUTCMinutes(),s:d.getUTCSeconds()}}function pdate(u){var d=new Date(u+O);try{var p=new Intl.DateTimeFormat("fa-IR",{weekday:"long",day:"numeric",month:"long",year:"numeric",timeZone:"Asia/Tehran"}).formatToParts(d),w="",dd="",m="",y="";for(var x of p){if(x.type==="weekday")w=x.value;if(x.type==="day")dd=x.value;if(x.type==="month")m=x.value;if(x.type==="year")y=x.value}return w+"، "+dd+" "+m+" "+y}catch(e){var dn=["یکشنبه","دوشنبه","سه‌شنبه","چهارشنبه","پنجشنبه","جمعه","شنبه"],mn=["فروردین","اردیبهشت","خرداد","تیر","مرداد","شهریور","مهر","آبان","آذر","دی","بهمن","اسفند"],jdm=[31,31,31,31,31,31,30,30,30,30,30,29],gdm=[31,28,31,30,31,30,31,31,30,31,30,31],g=d.getUTCDate(),mo=d.getUTCMonth()+1,ye=d.getUTCFullYear(),dn0=0;for(var i=0;i<mo-1;i++)dn0+=gdm[i];dn0+=g;if((ye%4===0&&ye%100!==0)||ye%400===0)if(mo>2)dn0++;var jy=ye-621,jday=dn0-79;if(jday<=0)jday+=365;var jm=0;if(jday>186){jday-=186;jm=6}while(jday>jdm[jm]){jday-=jdm[jm];jm++;if(jm>11)break}jm++;return dn[d.getUTCDay()]+"، "+fa(jday)+" "+mn[jm-1]+" "+fa(jy)}}function disp(){var u=now();if(u===null)return;var t=document.getElementById("pcw-t"),dd=document.getElementById("pcw-d"),i=iran(u);if(t)t.textContent=pad(i.h)+":"+pad(i.m)+":"+pad(i.s);if(dd)dd.textContent=pdate(u)}function resp(){var w=document.getElementById("pcw"),t=document.getElementById("pcw-t"),d=document.getElementById("pcw-d"),s=document.getElementById("pcw-s");if(!w||!t||!d||!s)return;function adj(){var ww=w.offsetWidth,tf,df,sf,p,b;if(ww<200){tf=Math.max(20,ww*.18);df=Math.max(9,ww*.07);sf=Math.max(6,ww*.05);p=Math.max(8,ww*.06);b=Math.max(8,ww*.08)}else if(ww<300){tf=Math.max(24,ww*.15);df=Math.max(10,ww*.06);sf=Math.max(7,ww*.045);p=Math.max(10,ww*.05);b=Math.max(10,ww*.06)}else if(ww<400){tf=Math.max(28,ww*.13);df=Math.max(11,ww*.05);sf=Math.max(8,ww*.04);p=Math.max(12,ww*.04);b=Math.max(12,ww*.05)}else{tf=56;df=20;sf=11;p=25;b=24}t.style.fontSize=tf+"px";t.style.letterSpacing=(tf*.09)+"px";d.style.fontSize=df+"px";d.style.padding=(df*.5)+"px "+(df*1)+"px";s.style.fontSize=sf+"px";s.style.padding=(sf*.5)+"px "+(sf*1.5)+"px";w.style.padding=p+"px";w.style.borderRadius=b+"px"}adj();if(typeof ResizeObserver!=="undefined")new ResizeObserver(adj).observe(w)}async function sync(){var s=document.getElementById("pcw-s");if(!s)return;var u=await api();if(u){start(u);s.textContent="✅ همگام با TimeAPI.io";if(si)clearInterval(si);si=setInterval(sync,R)}else{s.textContent=run?"⚠️ قطع ارتباط - ادامه با ساعت داخلی":"⚠️ خطا در دریافت زمان - تلاش مجدد...";if(si)clearInterval(si);si=setInterval(sync,3e4)}}async function init(){resp();await sync();if(di)clearInterval(di);di=setInterval(disp,100);if(!run)setTimeout(sync,5e3)}if(document.readyState==="loading")document.addEventListener("DOMContentLoaded",init);else init()})();<\/script></body></html>';function initFrame(){var f=document.getElementById("pcf");if(!f)return;var d=f.contentDocument||f.contentWindow.document;d.open();d.write(h);d.close();function ah(){try{var bh=d.body.scrollHeight;if(bh>0)f.style.height=bh+"px"}catch(e){f.style.height="180px"}}setTimeout(ah,500);if(typeof ResizeObserver!=="undefined")new ResizeObserver(ah).observe(d.body);setInterval(ah,2e3)}if(document.readyState==="loading")document.addEventListener("DOMContentLoaded",initFrame);else initFrame()})();
</script>

